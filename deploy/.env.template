# ========== 基础配置 ==========
APP_SECRET_KEY=<生成一个 UUID，如: uuidgen>
APP_HOST=0.0.0.0
APP_PORT=8000

# ========== 对外域名（重要） ==========
# SITE_BASE_URL：生成的邀约链接 / 二维码等对外链接使用的域名。
# - 阿里云正式环境：必须配置为正式域名，如 https://onlinetest.dakewe.cn
# - 本地开发 / 内网服务器：保持注释，自动从请求头推断（localhost / 内网 IP）
# SITE_BASE_URL=https://onlinetest.dakewe.cn

# ========== 管理员账户 ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<你的密码>

# ========== 数据库配置（使用 Docker 默认即可） ==========
POSTGRES_USER=mdquiz
POSTGRES_PASSWORD=mdquiz_password
POSTGRES_DB=mdquiz
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ========== 短信验证（可选） ==========
SMS_ENABLED=false
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_PNVS_SIGN_NAME=
# ALIYUN_PNVS_TEMPLATE_CODE=

# ========== 大模型评卷（可选） ==========
# 接入火山方舟 → 推理端点 → 填入 API Key 和模型
OPENAI_API_KEY=<火山方舟 API Key>
OPENAI_MODEL=deepseek-flash
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ========== MCP（可选） ==========
# MCP_ENABLED=true
# MCP_AUTH_TOKEN=<生成一个 token>
